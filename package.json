{
  "name": "arb-language-server",
  "description": "Language server for Flutter ARB localization files",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "out/",
    "schemas/"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "prepack": "npm run clean && npm run compile -- --incremental false"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "vscode-json-languageservice": "^5.7.2",
    "vscode-languageserver": "^8.1.0",
    "vscode-languageserver-textdocument": "^1.0.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.5.7",
    "typescript": "^5.2.2"
  }
}
